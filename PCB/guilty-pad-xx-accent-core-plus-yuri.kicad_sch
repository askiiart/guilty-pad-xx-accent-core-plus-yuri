	(text "hypothetically, if the battery and usb were both\nhooked up while discharging, then current would *probably*\nbe split between the two sources and work fine.\n\nthis would *probably* be fine with diodes there\n(on boost converter VOUT and xiao's +5V_USB),\nbut we can't do that, as we have to account\nfor battery charging over the same VBAT line\n\nbecause of this, there is a MOSFET that switches\nthe boost converter off when +5V_USB is applied,\n*and* diodes ensuring no current flows the wrong direction"
		(exclude_from_sim no)
		(at 42.926 266.446 0)
		(effects
			(font
				(size 0.635 0.635)
				(italic yes)
			)
		)
		(uuid "17a40455-af53-4f5d-ba9c-27c713df2ded")
	)
	(text "note to self:\ncapacitor can go either here\nor on +LED_5V"
		(exclude_from_sim no)
		(at 86.614 271.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "220f0236-33b3-4900-b41b-a4cfa0dc1f69")
	)
	(text "connector for batt, voltage divider, charging"
		(exclude_from_sim no)
		(at 44.704 170.942 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "22f2c6f7-1f91-492c-b636-75ac2332855e")
	)
	(text "note 4.8A switching current != 4.8A output current\n\nabsolute theoretical max ~2.5A output current\nthis diode is only rated for 2A and i only guarantee 1A based off datahseet"
		(exclude_from_sim no)
		(at 102.108 169.418 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
